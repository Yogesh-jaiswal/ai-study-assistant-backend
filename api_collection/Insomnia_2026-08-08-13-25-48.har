					"content": {
						"size": 18070,
						"mimeType": "application/json",
						"text": "{\n  \"data\": {\n    \"evaluated_at\": \"Fri, 07 Aug 2026 12:30:00 GMT\",\n    \"evaluation\": {\n      \"evaluation\": {\n        \"description\": \"A short formative assessment designed to evaluate recall and conceptual understanding through primarily multiple-choice questions. Suitable for classroom quizzes, practice tests, and quick knowledge checks.\",\n        \"difficulty\": \"easy\",\n        \"duration\": \"25 minutes\",\n        \"exam_name\": \"Standard Quiz\",\n        \"navigation_rules\": {\n          \"allow_cross_section_navigation\": true,\n          \"has_sectional_timers\": false,\n          \"is_computer_adaptive\": false\n        },\n        \"overall_feedback\": \"The student demonstrated a strong understanding of core Artificial Intelligence, Machine Learning, and related Python concepts, scoring 26 out of 30 marks. Most multiple-choice and true/false questions were answered correctly, indicating solid recall and conceptual grasp. There was one incorrect answer for Q8 and Q15 was not attempted. Reviewing these specific areas would be beneficial for further improvement.\",\n        \"sections\": [\n          {\n            \"obtained_marks\": 26.0,\n            \"question_groups\": [\n              {\n                \"alternatives\": null,\n                \"defaults\": {\n                  \"answer_type\": \"single_choice\",\n                  \"negative_marking\": 0,\n                  \"question_type\": \"MCQ\"\n                },\n                \"group_title\": \"Multiple Choice Questions\",\n                \"obtained_marks\": 18.0,\n                \"parts\": [\n                  {\n                    \"count\": 10,\n                    \"label\": \"Q1-Q10\",\n                    \"marks\": 2\n                  }\n                ],\n                \"questions\": [\n                  {\n                    \"feedback\": \"Correct answer. AI systems are capable of understanding language.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Only performing arithmetic calculations\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Understanding language\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Replacing all human jobs directly\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Cooking complex meals\"\n                      }\n                    ],\n                    \"question\": \"Which of the following is a common capability of Artificial Intelligence (AI) systems?\",\n                    \"question_id\": \"38aeb0a1-bfa0-472e-955d-56011df5aab7\",\n                    \"question_label\": \"Q1\",\n                    \"user_answer\": \"B\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Machine Learning is a subset of Artificial Intelligence.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Data Entry\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Web Design\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Artificial Intelligence\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Computer Hardware Engineering\"\n                      }\n                    ],\n                    \"question\": \"Machine Learning (ML) is described as a subset of which broader field?\",\n                    \"question_id\": \"1114ce83-a1b6-4df3-ab53-e5ec5b51e8ac\",\n                    \"question_label\": \"Q2\",\n                    \"user_answer\": \"C\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Supervised Learning is a primary paradigm in Machine Learning.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Static Learning\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Manual Learning\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Supervised Learning\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Analog Learning\"\n                      }\n                    ],\n                    \"question\": \"Which of these is one of the three primary learning paradigms in Machine Learning?\",\n                    \"question_id\": \"c833af4e-535d-445a-8fba-d09b0d857d68\",\n                    \"question_label\": \"Q3\",\n                    \"user_answer\": \"C\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Deep Learning is based on artificial neural networks.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Flowcharts\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Artificial neural networks\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Spreadsheets\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Binary trees\"\n                      }\n                    ],\n                    \"question\": \"Deep Learning is a specialized area of Machine Learning based on what structures?\",\n                    \"question_id\": \"ecf7c034-a7bc-48fc-8cb0-78b0020c27dd\",\n                    \"question_label\": \"Q4\",\n                    \"user_answer\": \"B\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. GPUs are essential for efficient Deep Learning model training.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Standard USB drives\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"CD-ROM readers\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"CPUs only\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"GPUs\"\n                      }\n                    ],\n                    \"question\": \"Which hardware component is often required for efficient training of Deep Learning models?\",\n                    \"question_id\": \"2592c123-d391-4a8a-b2e9-fa8261d5c258\",\n                    \"question_label\": \"Q5\",\n                    \"user_answer\": \"D\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Natural Language Processing (NLP) enables computers to understand and generate human language.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Control industrial robots\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Design graphical user interfaces\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Understand and generate human language\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Manage electrical grids\"\n                      }\n                    ],\n                    \"question\": \"Natural Language Processing (NLP) enables computers to perform which primary function?\",\n                    \"question_id\": \"a6eba61d-3a85-400d-bcc5-acb3671faeb9\",\n                    \"question_label\": \"Q6\",\n                    \"user_answer\": \"C\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Retrieval-Augmented Generation (RAG) reduces hallucinations by grounding answers in external knowledge.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"It always makes the AI faster without any downside.\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"It allows AI to predict future stock prices perfectly.\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"It reduces hallucinations by grounding answers in external knowledge.\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"It enables AI to perform surgery autonomously.\"\n                      }\n                    ],\n                    \"question\": \"What is the main advantage of Retrieval-Augmented Generation (RAG) in AI systems?\",\n                    \"question_id\": \"8395ae78-73ff-4871-ac92-ac54ff79fd2b\",\n                    \"question_label\": \"Q7\",\n                    \"user_answer\": \"C\"\n                  },\n                  {\n                    \"feedback\": \"Incorrect answer. Vector embeddings convert text into dense numerical vectors, not image files. This answer is incorrect as text is converted into numerical representations for machine processing.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 0.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Image files\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Audio recordings\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Dense numerical vectors\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"HTML pages\"\n                      }\n                    ],\n                    \"question\": \"What do vector embeddings convert text into?\",\n                    \"question_id\": \"33fbbfc8-9db2-4029-a03b-623b174f47ef\",\n                    \"question_label\": \"Q8\",\n                    \"user_answer\": \"A\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Flask is a lightweight Python web framework commonly used for REST APIs.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"NumPy\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Flask\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Pandas\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Scikit-learn\"\n                      }\n                    ],\n                    \"question\": \"Which of the following is a lightweight Python web framework commonly used for REST APIs?\",\n                    \"question_id\": \"58c1441a-ad62-4cb3-908c-96f596d84216\",\n                    \"question_label\": \"Q9\",\n                    \"user_answer\": \"B\"\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Celery is primarily used for distributed task queuing for asynchronous work in Python development.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": [\n                      {\n                        \"label\": \"A\",\n                        \"text\": \"Developing graphical user interfaces\"\n                      },\n                      {\n                        \"label\": \"B\",\n                        \"text\": \"Synchronous database queries\"\n                      },\n                      {\n                        \"label\": \"C\",\n                        \"text\": \"Distributed task queuing for asynchronous work\"\n                      },\n                      {\n                        \"label\": \"D\",\n                        \"text\": \"Scientific data plotting\"\n                      }\n                    ],\n                    \"question\": \"What is Celery primarily used for in Python development?\",\n                    \"question_id\": \"8df02efa-3d44-4b46-9d3c-a9d86e908121\",\n                    \"question_label\": \"Q10\",\n                    \"user_answer\": \"C\"\n                  }\n                ],\n                \"selection_rule\": {\n                  \"count\": null,\n                  \"type\": \"all\"\n                },\n                \"shared_material\": null\n              },\n              {\n                \"alternatives\": null,\n                \"defaults\": {\n                  \"answer_type\": \"boolean\",\n                  \"negative_marking\": 0,\n                  \"question_type\": \"TrueFalse\"\n                },\n                \"group_title\": \"True/False Questions\",\n                \"obtained_marks\": 8.0,\n                \"parts\": [\n                  {\n                    \"count\": 5,\n                    \"label\": \"Q11-Q15\",\n                    \"marks\": 2\n                  }\n                ],\n                \"questions\": [\n                  {\n                    \"feedback\": \"Correct answer. AI systems are used in a wide variety of industries beyond just healthcare.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": null,\n                    \"question\": \"AI systems are only used in the healthcare industry and no other industries.\",\n                    \"question_id\": \"193e91c2-8a49-4125-b80b-93b99637cda6\",\n                    \"question_label\": \"Q11\",\n                    \"user_answer\": false\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Deep Learning is indeed a specialized area of Machine Learning.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": null,\n                    \"question\": \"Deep Learning is a specialized area of Machine Learning.\",\n                    \"question_id\": \"bdaefe65-5b2a-44eb-b7a5-3f1b71f491bf\",\n                    \"question_label\": \"Q12\",\n                    \"user_answer\": true\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Large Language Models (LLMs) are considered advanced Natural Language Processing (NLP) systems.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": null,\n                    \"question\": \"Large Language Models (LLMs) are considered advanced Natural Language Processing (NLP) systems.\",\n                    \"question_id\": \"d4464967-e5ff-4f9d-8fd8-bcb7bb7105da\",\n                    \"question_label\": \"Q13\",\n                    \"user_answer\": true\n                  },\n                  {\n                    \"feedback\": \"Correct answer. Cosine similarity is a common similarity metric used with vector embeddings.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 2.0,\n                    \"options\": null,\n                    \"question\": \"Cosine similarity is a common similarity metric used with vector embeddings.\",\n                    \"question_id\": \"e1360128-1b0c-41ab-9cac-699073d32c5c\",\n                    \"question_label\": \"Q14\",\n                    \"user_answer\": true\n                  },\n                  {\n                    \"feedback\": \"Question not attempted.\",\n                    \"marks\": 2,\n                    \"negative_marking\": 0,\n                    \"obtained_marks\": 0.0,\n                    \"options\": null,\n                    \"question\": \"PostgreSQL is primarily known as a distributed task queue for Python.\",\n                    \"question_id\": \"80101bb3-7d27-4b30-841f-25f560784302\",\n                    \"question_label\": \"Q15\",\n                    \"user_answer\": null\n                  }\n                ],\n                \"selection_rule\": {\n                  \"count\": null,\n                  \"type\": \"all\"\n                },\n                \"shared_material\": null\n              }\n            ],\n            \"section_duration\": null,\n            \"section_name\": \"Quiz\",\n            \"total_marks\": 30\n          }\n        ],\n        \"total_marks\": 30\n      },\n      \"obtained_marks\": 26.0,\n      \"percentage\": 86.66666666666667,\n      \"total_marks\": 30\n    },\n    \"evaluation_type\": \"exam\",\n    \"id\": \"bdf34ca0-9b6c-468f-b0ca-6941da8acd6d\",\n    \"obtained_marks\": 26,\n    \"percentage\": 86.66666666666667,\n    \"status\": \"completed\",\n    \"total_marks\": 30\n  },\n  \"error\": null,\n  \"success\": true\n}\n"
