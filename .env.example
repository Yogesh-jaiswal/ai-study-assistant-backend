# App location
FLASK_APP=app.factory:create_app

# App Settings
DEBUG=True
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Model Settings
AI_MODEL=GEMINI
MODEL_API_KEY=<ai_api_key>
MODEL_NAME=gemini-2.0-flash

# Legacy Quiz Settings
DEFAULT_QUIZ_COUNT=5
MAX_QUIZ_QUESTIONS=20
DEFAULT_QUIZ_LEVEL=medium

# Legacy Notes Settings
MAX_NOTES_LENGTH=1000

# Rate Limiter Settings
RATELIMIT_ENABLED=True
DEFAULT_GLOBAL_LIMIT=["200/day", "50/hour"]
LIMITER_STORAGE_URI=memory://
LIMITER_STRATEGY=moving-window
RATELIMIT_HEADERS_ENABLED=True
SUMMARY_RATE_LIMIT=10/minute
QUIZ_RATE_LIMIT=5/minute
ASK_RATE_LIMIT=15/minute

# Database Settings
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=7}%(&oM5ap3{_o''
POSTGRES_DB=ai_study_assistant
SQLALCHEMY_TRACK_MODIFICATIONS=False
HNSW_EF_SEARCH=100

# Upload Settings
MAX_CONTENT_LENGTH=10485760 # 10 MB
UPLOAD_FOLDER=file_uploads

# JWT Settings
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_MINUTES = 15

# Login Settings
DUMMY_HASH=<generate_with_argon2>

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery Settings
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# Embeddings Settings
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Database Query Settings
MIN_SIMILARITY=0.4

# Pagination Settings
MAX_LIMIT=100