DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=development

AI_MODEL=FAKE
MODEL_API_KEY=fake
MODEL_NAME=gemini-2.0-flash

DEFAULT_QUIZ_COUNT=5
MAX_QUIZ_QUESTIONS=20
DEFAULT_QUIZ_LEVEL=medium

MAX_NOTES_LENGTH=1000

RATELIMIT_ENABLED=True
DEFAULT_GLOBAL_LIMIT=["200/day", "50/hour"]
LIMITER_STORAGE_URI=memory://
LIMITER_STRATEGY=moving-window
RATELIMIT_HEADERS_ENABLED=True
SUMMARY_RATE_LIMIT=10/minute
QUIZ_RATE_LIMIT=5/minute
ASK_RATE_LIMIT=15/minute

DATABASE_URL=sqlite:///study_assistant.db
SQLALCHEMY_TRACK_MODIFICATIONS=False
USE_PGVECTOR=False
HNSW_EF_SEARCH=100

MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=file_uploads

JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_MINUTES = 15

DUMMY_HASH=<generate_with_argon2>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

EMBEDDINGS_MODEL=all-MiniLM-L6-v2

MIN_SIMILARITY=0.4

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_study_assistant